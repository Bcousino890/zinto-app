DATABASE_URL=postgresql://USER:PASSWORD@powerchat-postgres-bcousinoprop:5432/DATABASE
LEGACY_API_URL=http://powerchat-app-bcousinoprop:9000
WEBHOOK_ENCRYPTION_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
READ_ONLY_MODE=true
WEBHOOK_WORKER_ENABLED=false
TRUST_PROXY=true
LOG_LEVEL=info
PORT=3100
HOST=0.0.0.0

# Media proxy. While disabled the engine resolves the partner URL itself, which
# leaves the DNS rebinding window open, so send-media must stay closed to third
# parties. Enabling it requires MEDIA_INTERNAL_BASE_URL, a writable
# MEDIA_STORAGE_DIR, and denying /_integration-api/internal/ at the reverse proxy.
MEDIA_PROXY_ENABLED=false
MEDIA_INTERNAL_BASE_URL=http://zinto-integration-api-preview:3100
MEDIA_STORAGE_DIR=/var/lib/zinto-media
MEDIA_MAX_BYTES=16777216
MEDIA_RETENTION_MINUTES=60

